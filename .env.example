# ============================================================
# AI 퀀트 시그널 - 환경 변수 템플릿
#
# 절대 클라이언트에 노출되지 않습니다. 모든 API 호출은 src/pages/api/* (서버사이드)에서만 사용하세요.
# 사용 시: 이 파일을 .env 로 복사한 뒤, 아래 각 항목에 본인의 키·값을 직접 넣으세요.
# ============================================================

# OpenAI (GPT-4o) — https://platform.openai.com/api-keys 에서 발급한 키를 넣으세요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 뉴스 데이터 소스 (셋 중 가능한 것 하나만 채워도 동작) — 각 서비스에서 발급한 키를 넣으세요.
NEWS_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_KEY=

# EmDash 쓰기 권한
# 로컬 개발 환경에서는 EMDASH_DEV_BYPASS=true 만 켜두면 됩니다 (localhost 한정).
# 운영에서는 Admin → Settings → API Tokens 에서 PAT를 발급받아 EMDASH_API_TOKEN 에 넣으세요.
EMDASH_BASE_URL=http://localhost:4321
EMDASH_DEV_BYPASS=true
EMDASH_API_TOKEN=

# YouTube Data API v3 (블로그 하단 추천 영상 자동 연동)
# https://console.cloud.google.com/apis/library/youtube.googleapis.com — 본인 프로젝트의 API 키를 넣으세요.
YOUTUBE_API_KEY=
# 캐시 TTL(초). 같은 키워드 묶음 호출 시 quota 절약 (기본 900초 = 15분).
YOUTUBE_CACHE_TTL_SEC=900

# 자동화 보호 (옵션) - /api/* 호출 시 헤더 X-Cron-Secret 으로 검증합니다. 임의의 긴 문자열을 직접 정해 넣으세요.
CRON_SECRET=
# 관리자 파이프라인 API (옵션) - POST /api/admin/run-news-pipeline 시 X-Admin-Pipeline-Secret. 직접 정한 비밀값을 넣으세요.
ADMIN_PIPELINE_SECRET=
